{
  "opencollection": "1.0.0",
  "info": {
    "name": "tl;dv Meetings System API",
    "version": "v1alpha1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Service health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pasta.tldv.io/v1alpha1/health"
          },
          "docs": "Verify that the API service is available."
        }
      ]
    }
  ],
  "bundled": true
}