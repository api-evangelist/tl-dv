{
  "opencollection": "1.0.0",
  "info": {
    "name": "tl;dv Meetings API",
    "version": "v1alpha1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Meetings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List meetings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pasta.tldv.io/v1alpha1/meetings",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number of results to return."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page."
              },
              {
                "name": "meetingType",
                "value": "",
                "type": "query",
                "description": "Filter meetings by type."
              }
            ]
          },
          "docs": "Returns a paginated list of meetings for the authenticated account."
        },
        {
          "info": {
            "name": "Import a meeting",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pasta.tldv.io/v1alpha1/meetings/import",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Import a meeting recording from an external URL for processing."
        },
        {
          "info": {
            "name": "Retrieve a meeting",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pasta.tldv.io/v1alpha1/meetings/:meetingId",
            "params": [
              {
                "name": "meetingId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the meeting."
              }
            ]
          },
          "docs": "Retrieve a single meeting by its identifier."
        },
        {
          "info": {
            "name": "Download a meeting recording",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pasta.tldv.io/v1alpha1/meetings/:meetingId/download",
            "params": [
              {
                "name": "meetingId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the meeting."
              }
            ]
          },
          "docs": "Returns a 302 redirect whose Location header points at a signed URL for the meeting recording file.\n"
        }
      ]
    }
  ],
  "bundled": true
}